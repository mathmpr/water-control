<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <%- include('./common/head.ejs', {title: 'Entrar | Water Control'}) %>
</head>
<body>
<section class="login-view">
    <div class="login-shell">
        <div class="login-card">
            <div class="brand-lockup">
                <span class="brand-mark" aria-hidden="true">W</span>
                <div>
                    <div class="brand-name">Water Control</div>
                    <div class="brand-caption">Automação da bomba</div>
                </div>
            </div>

            <h1 class="login-title">Entrar</h1>
            <p class="login-subtitle">Acesse sua conta para controlar e monitorar a bomba.</p>

            <% if (typeof error !== 'undefined') { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <form method="POST" action="api/sign-in">
                <div class="mb-3">
                    <label for="email" class="form-label">E-mail ou username</label>
                    <input type="text" class="form-control" id="email" name="email" placeholder="voce@exemplo.com" autocomplete="username" required autofocus>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Senha</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="********" autocomplete="current-password" required>
                </div>

                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>

            <div class="login-footer">
                <a href="/sign-up">Solicitar acesso</a>
            </div>
        </div>
    </div>
</section>
<%- include('common/end.ejs') %>
<script>
    $(document).ready(function() {
        let form = $('form');
        form.on('submit', function(event) {
            event.preventDefault();
            axios.post(form.attr('action'), {
                email: $('#email').val(),
                password: $('#password').val()
            }).then(function(response) {
                if (response.data.token) {
                    localStorage.setItem('token', response.data.token);
                    window.location.href = '/admin';
                } else {
                    toastr.error('Erro ao entrar. Por favor, verifique suas credenciais.');
                }
            }).catch(function(error) {
                toastr.error('Erro ao entrar. Por favor, tente novamente.');
            });
        });
    });
</script>
</body>
</html>
