<aside class="sidebar">
    <div class="sidebar-inner d-flex flex-column">
        <a class="sidebar-brand" href="/admin">
            <span class="brand-mark" aria-hidden="true">W</span>
            <span class="brand-text">
                <span class="brand-name">Water Control</span>
                <span class="brand-caption">Automação da bomba</span>
            </span>
        </a>

        <div class="sidebar-section-title">Principal</div>
        <nav class="sidebar-menu">
            <a class="nav-link <%= title === 'Water - Logs' ? 'active' : '' %>" href="/admin">
                <span class="nav-icon" aria-hidden="true">≋</span>
                <span class="nav-label">Logs e status</span>
            </a>
            <% if (user.roles.includes('admin')) { %>
                <a class="nav-link <%= title === 'Configurações' ? 'active' : '' %>" href="/admin/settings">
                    <span class="nav-icon" aria-hidden="true">⚙</span>
                    <span class="nav-label">Configurações</span>
                </a>
            <% } %>
        </nav>

        <div class="sidebar-footer">
            <div class="profile-box">
                <div class="profile-avatar"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div>
                <div class="profile-copy flex-grow-1 overflow-hidden">
                    <div class="profile-name text-truncate"><%= user.name %></div>
                    <div class="profile-role text-truncate">Alexa 2FA: <%= user.alexa_2fa %></div>
                </div>
                <a id="sign-out" class="icon-btn" href="/api/sign-out" title="Sair" aria-label="Sair">↪</a>
            </div>
        </div>
    </div>
</aside>

<main class="main">
    <header class="topbar">
        <div class="d-flex align-items-center gap-2">
            <button id="mobileMenuBtn" class="icon-btn mobile-menu-btn" type="button" title="Menu" aria-label="Menu">☰</button>
            <div class="topbar-title"><%= title %></div>
        </div>
        <div class="topbar-actions">
            <span class="topbar-user text-truncate"><%= user.name %></span>
        </div>
    </header>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        $('#mobileMenuBtn').on('click', function () {
            document.body.classList.toggle('sidebar-mobile-open');
        });

        $(document).on('click', function (event) {
            if (
                window.innerWidth < 992
                && document.body.classList.contains('sidebar-mobile-open')
                && !event.target.closest('.sidebar')
                && !event.target.closest('#mobileMenuBtn')
            ) {
                document.body.classList.remove('sidebar-mobile-open');
            }
        });

        let signOut = $('a#sign-out');
        signOut.on('click', function (e) {
            e.preventDefault();
            axios.get(signOut.attr('href'))
                .then(function (response) {
                    if (response.data.success) {
                        window.location.href = '/';
                    } else {
                        toastr.error('Erro ao sair');
                    }
                })
                .catch(function (error) {
                    toastr.error('Erro ao sair. Tente novamente.');
                });
        });
    });
</script>
